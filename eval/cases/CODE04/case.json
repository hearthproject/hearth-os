{
  "schemaVersion": 1,
  "id": "CODE04",
  "version": 1,
  "title": "补全 API 契约测试",
  "family": "code",
  "difficulty": "normal",
  "runModes": ["offline"],
  "description": "为缺少错误分支的 API 补契约测试。",
  "goal": "新增 400、404 和幂等重放测试，保持生产代码不变。",
  "tags": ["api", "contract-test"],
  "timeoutMs": 600000,
  "inputs": [{"kind": "file", "label": "路由与现状", "path": "input.json"}],
  "expectedOutputs": ["contract-report.json"],
  "graders": [
    {"id": "file", "title": "契约报告存在", "config": {"kind": "file", "path": "contract-report.json", "minBytes": 40}},
    {"id": "facts", "title": "测试分支和结果完整", "config": {"kind": "json", "path": "contract-report.json", "equals": {"productionCodeChanged":false,"testsPassed":true}, "minArrayLength": {"cases": 3}}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出契约测试报告", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "错误分支和幂等测试完整", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "测试可维护且不改生产代码", "source": "judge", "points": 30, "severity": "scored", "rubric": "覆盖状态码、错误结构和重复请求，断言稳定。"},
    {"id": "human", "label": "工程师复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对测试分支和运行结果。", "sampleRate": 0.1}
}
