{
  "schemaVersion": 1,
  "id": "WEB04",
  "version": 1,
  "title": "404、重定向与超时降级",
  "family": "web",
  "difficulty": "failure",
  "runModes": ["offline"],
  "description": "处理一个成功、一个重定向、一个超时的抓取结果。",
  "goal": "保留最终 URL 和失败原因，不伪造超时页面正文。",
  "tags": ["failure", "http"],
  "timeoutMs": 300000,
  "inputs": [{"kind": "file", "label": "抓取结果", "path": "input.json"}],
  "expectedOutputs": ["extract.json"],
  "graders": [
    {"id": "file", "title": "抓取报告存在", "config": {"kind": "file", "path": "extract.json", "minBytes": 60}},
    {"id": "facts", "title": "状态和失败原因正确", "config": {"kind": "json", "path": "extract.json", "equals": {"successCount":1,"redirectCount":1,"timeoutCount":1,"fabricatedBody":false}, "minArrayLength": {"pages": 3}}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出抓取报告", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "状态和失败原因完整", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "失败诚实且可恢复", "source": "judge", "points": 30, "severity": "scored", "rubric": "超时页面没有伪造正文，记录最终 URL 和下一步。"},
    {"id": "human", "label": "人工复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对失败状态和最终 URL。", "sampleRate": 0.1}
}
