{
  "schemaVersion": 1,
  "id": "DOC02",
  "version": 1,
  "title": "长合同条款抽取与引用核对",
  "family": "documents",
  "difficulty": "edge",
  "runModes": ["offline"],
  "description": "从长合同中抽取责任、终止和付款条款并核对引用。",
  "goal": "输出带页码、原文摘录和缺失附件的条款表。",
  "tags": ["contract", "citation"],
  "timeoutMs": 600000,
  "inputs": [{"kind": "file", "label": "合同分页文本", "path": "input.json"}],
  "expectedOutputs": ["clauses.json"],
  "graders": [
    {"id": "file", "title": "条款表存在", "config": {"kind": "file", "path": "clauses.json", "minBytes": 60}},
    {"id": "facts", "title": "关键条款与缺失附件正确", "config": {"kind": "json", "path": "clauses.json", "equals": {"liabilityCap":"12 个月服务费","missingAttachmentCount":1}, "minArrayLength": {"clauses": 3}}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出条款表", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "条款、页码和缺失项正确", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "引用可核对", "source": "judge", "points": 30, "severity": "scored", "rubric": "每条结论均有页码和原文摘录，不输出法律有效性判断。"},
    {"id": "human", "label": "法务复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "抽查页码、原文和缺失附件。", "sampleRate": 0.1}
}
