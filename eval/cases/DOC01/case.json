{
  "schemaVersion": 1,
  "id": "DOC01",
  "version": 1,
  "title": "文档版本差异与发布影响",
  "family": "documents",
  "difficulty": "edge",
  "runModes": ["offline"],
  "description": "比较同一政策文档两个版本并说明发布影响。",
  "goal": "列出实质变更、受影响读者、兼容风险和建议发布动作。",
  "tags": ["diff", "release"],
  "timeoutMs": 300000,
  "inputs": [{"kind": "file", "label": "两个版本文档", "path": "input.json"}],
  "expectedOutputs": ["diff.md"],
  "graders": [
    {"id": "file", "title": "差异报告存在", "config": {"kind": "file", "path": "diff.md", "minBytes": 60}},
    {"id": "facts", "title": "关键变更和影响齐全", "config": {"kind": "text", "path": "diff.md", "includes": ["48 小时", "30 天", "影响", "回滚"]}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出差异报告", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "实质变更和影响完整", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "区分格式与实质变化", "source": "judge", "points": 30, "severity": "scored", "rubric": "不把排版变化误报为政策变化，提供兼容风险和发布建议。"},
    {"id": "human", "label": "人工复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对变更分类与发布影响。", "sampleRate": 0.1}
}
