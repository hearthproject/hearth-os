{
  "schemaVersion": 1,
  "id": "CAL02",
  "version": 1,
  "title": "会议改期与通知草稿",
  "family": "calendar",
  "difficulty": "normal",
  "runModes": ["offline"],
  "description": "把现有会议移动到新时段并生成通知草稿。",
  "goal": "检查新时段冲突，保留会议 ID，生成通知草稿但不发送。",
  "tags": ["reschedule", "notification"],
  "timeoutMs": 300000,
  "inputs": [{"kind": "file", "label": "会议与日历", "path": "input.json"}],
  "expectedOutputs": ["reschedule.json"],
  "graders": [
    {"id": "file", "title": "改期结果存在", "config": {"kind": "file", "path": "reschedule.json", "minBytes": 40}},
    {"id": "facts", "title": "会议 ID 与通知状态正确", "config": {"kind": "json", "path": "reschedule.json", "equals": {"eventId":"evt-42","newStart":"2026-11-17T14:30:00+08:00","notificationStatus":"draft"}}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出改期结果", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "会议身份和通知状态正确", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "改期说明完整", "source": "judge", "points": 30, "severity": "scored", "rubric": "说明旧时间、新时间、冲突结果和通知范围，未发送通知。"},
    {"id": "human", "label": "人工复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对新时段和通知范围。", "sampleRate": 0.1}
}
