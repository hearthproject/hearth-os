{
  "schemaVersion": 1,
  "id": "T14",
  "version": 1,
  "title": "课程转教案与测验",
  "family": "documents",
  "difficulty": "normal",
  "runModes": ["offline"],
  "description": "为七年级科学课生成 45 分钟教案和测验。",
  "goal": "生成 45 分钟教案、8 题测验和答案解析，正确处理三个常见误区。",
  "tags": ["legacy", "education", "quiz"],
  "timeoutMs": 600000,
  "inputs": [{"kind": "file", "label": "课程资料", "path": "eval/inputs/T14-curriculum-source.md"}],
  "expectedOutputs": ["lesson-plan.md", "quiz.md", "answer-key.md"],
  "graders": [
    {"id": "lesson-file", "title": "教案与测验文件齐全", "config": {"kind": "artifact_count", "suffix": ".md", "min": 3}},
    {"id": "lesson-facts", "title": "45 分钟与误区处理完整", "config": {"kind": "text", "path": "lesson-plan.md", "includes": ["45 分钟", "学习目标", "误区"]}}
  ],
  "criteria": [
    {"id": "lesson-exist", "label": "输出三类交付", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "lesson-file"},
    {"id": "lesson-facts", "label": "时长、目标和误区齐全", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "lesson-facts"},
    {"id": "lesson-quality", "label": "教学活动和测验设计一致", "source": "judge", "points": 30, "severity": "scored", "rubric": "三个学习目标都映射到活动与评估，8 题覆盖记忆、理解、实验设计和误区辨析。"},
    {"id": "lesson-human", "label": "教师复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对 45 分钟分配、8 题和三个误区。", "sampleRate": 0.1}
}
