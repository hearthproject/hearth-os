{
  "schemaVersion": 1,
  "id": "XAPP01",
  "version": 1,
  "title": "会议邮件转日历与纪要草稿",
  "family": "cross-app",
  "difficulty": "normal",
  "runModes": ["offline"],
  "description": "从会议邀约邮件生成日历事件和纪要模板。",
  "goal": "串联邮件、日历和文档动作，保持同一会议引用且不发送。",
  "tags": ["email", "calendar", "documents"],
  "timeoutMs": 600000,
  "inputs": [{"kind": "file", "label": "邮件与日历", "path": "input.json"}],
  "expectedOutputs": ["state.json"],
  "graders": [
    {"id": "file", "title": "跨应用状态存在", "config": {"kind": "file", "path": "state.json", "minBytes": 60}},
    {"id": "facts", "title": "事件、文档与发送状态正确", "config": {"kind": "json", "path": "state.json", "equals": {"calendarCreated":true,"notesCreated":true,"emailSent":false}, "minArrayLength": {"actions": 3}}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出跨应用状态", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "日历、文档和邮件状态正确", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "会议引用和去重一致", "source": "judge", "points": 30, "severity": "scored", "rubric": "邮件、日历和纪要保持同一会议引用，未发送任何外部消息。"},
    {"id": "human", "label": "人工复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对会议引用和跨应用状态。", "sampleRate": 0.1}
}
