{
  "schemaVersion": 1,
  "id": "CODE05",
  "version": 1,
  "title": "依赖升级兼容性评估",
  "family": "code",
  "difficulty": "edge",
  "runModes": ["offline"],
  "description": "评估主版本依赖升级的破坏性变化和迁移计划。",
  "goal": "找出受影响 API、测试结果、回滚方案和需要人工确认的风险。",
  "tags": ["dependencies", "migration"],
  "timeoutMs": 600000,
  "inputs": [{"kind": "file", "label": "依赖与代码调用", "path": "input.json"}],
  "expectedOutputs": ["upgrade.json"],
  "graders": [
    {"id": "file", "title": "升级评估存在", "config": {"kind": "file", "path": "upgrade.json", "minBytes": 40}},
    {"id": "facts", "title": "破坏性变化和回滚正确", "config": {"kind": "json", "path": "upgrade.json", "equals": {"breakingChanges":2,"safeToMerge":false,"rollback":"restore lockfile and image"}}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出升级评估", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "破坏性变化和回滚方案完整", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "迁移计划可执行", "source": "judge", "points": 30, "severity": "scored", "rubric": "受影响调用点明确，测试和回滚步骤可执行，不掩盖失败。"},
    {"id": "human", "label": "维护者复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对破坏性变化和回滚方案。", "sampleRate": 0.1}
}
