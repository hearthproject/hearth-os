{
  "schemaVersion": 1,
  "id": "T01",
  "version": 1,
  "title": "会议转写转行动纪要",
  "family": "documents",
  "difficulty": "normal",
  "runModes": ["offline"],
  "description": "把会议原始记录整理成结论、行动项和待确认问题。",
  "goal": "根据会议原始记录生成可直接发送的行动纪要，保留来源索引，不编造未讨论的信息。",
  "tags": ["legacy", "meeting", "action-items"],
  "timeoutMs": 600000,
  "inputs": [{"kind": "file", "label": "会议原始记录", "path": "eval/inputs/T01-meeting-transcript.md"}],
  "expectedOutputs": ["meeting-notes.md"],
  "graders": [
    {"id": "notes-file", "title": "行动纪要存在", "config": {"kind": "file", "path": "meeting-notes.md", "minBytes": 100}},
    {"id": "notes-facts", "title": "关键行动项完整", "config": {"kind": "text", "path": "meeting-notes.md", "includes": ["周启修", "陈语", "2026-11-11", "待确认"]}}
  ],
  "criteria": [
    {"id": "notes-exist", "label": "输出会议纪要", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "notes-file"},
    {"id": "notes-facts", "label": "行动项、日期和待确认项正确", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "notes-facts"},
    {"id": "notes-quality", "label": "来源可追溯且未编造", "source": "judge", "points": 30, "severity": "scored", "rubric": "行动项和已决事项都有原文或时间戳依据，未讨论内容没有出现。"},
    {"id": "notes-human", "label": "人工验收", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对行动项、负责人、截止日期和待确认问题。", "sampleRate": 0.1}
}
