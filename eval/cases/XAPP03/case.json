{
  "schemaVersion": 1,
  "id": "XAPP03",
  "version": 1,
  "title": "客服工单知识库与跟进日程",
  "family": "cross-app",
  "difficulty": "edge",
  "runModes": ["offline"],
  "description": "组合工单、知识库和日历生成升级方案与跟进安排。",
  "goal": "识别知识缺口，创建内部跟进提醒，不向客户发送消息。",
  "tags": ["support", "calendar", "knowledge"],
  "timeoutMs": 600000,
  "inputs": [{"kind": "file", "label": "工单与知识库", "path": "input.json"}],
  "expectedOutputs": ["followup.json"],
  "graders": [
    {"id": "file", "title": "跟进方案存在", "config": {"kind": "file", "path": "followup.json", "minBytes": 60}},
    {"id": "facts", "title": "知识缺口与提醒状态正确", "config": {"kind": "json", "path": "followup.json", "equals": {"knowledgeGap":true,"calendarReminderCreated":true,"customerMessageSent":false}}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出跟进方案", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "知识缺口和提醒状态正确", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "升级路径合理且不越权", "source": "judge", "points": 30, "severity": "scored", "rubric": "知识缺口说明清楚，提醒只发给内部人员，不发送客户回复。"},
    {"id": "human", "label": "客服负责人复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对知识缺口和内部提醒。", "sampleRate": 0.1}
}
