{
  "schemaVersion": 1,
  "id": "WEB01",
  "version": 1,
  "title": "文档页面转操作指南",
  "family": "web",
  "difficulty": "normal",
  "runModes": ["offline"],
  "description": "把产品文档快照转成可执行操作指南。",
  "goal": "保留前置条件、步骤、验证和故障处理，不遗漏原文限制。",
  "tags": ["documentation", "how-to"],
  "timeoutMs": 300000,
  "inputs": [{"kind": "file", "label": "文档快照", "path": "input.json"}],
  "expectedOutputs": ["guide.md"],
  "graders": [
    {"id": "file", "title": "指南存在", "config": {"kind": "file", "path": "guide.md", "minBytes": 60}},
    {"id": "facts", "title": "前置条件与验证步骤齐全", "config": {"kind": "text", "path": "guide.md", "includes": ["前置条件", "验证", "故障处理"]}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出操作指南", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "前置、步骤和验证齐全", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "步骤可按顺序执行", "source": "judge", "points": 30, "severity": "scored", "rubric": "操作步骤无跳跃，命令和界面路径明确，限制条件未被删除。"},
    {"id": "human", "label": "文档复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "按指南走一遍关键步骤。", "sampleRate": 0.1}
}
