{
  "schemaVersion": 1,
  "id": "WEB03",
  "version": 1,
  "title": "网页表格转 CSV",
  "family": "web",
  "difficulty": "edge",
  "runModes": ["offline"],
  "description": "抽取网页表格并处理合并单元格和缺失值。",
  "goal": "生成可解析 CSV，保留表头并记录异常。",
  "tags": ["table", "csv"],
  "timeoutMs": 300000,
  "inputs": [{"kind": "file", "label": "表格 HTML", "path": "input.json"}],
  "expectedOutputs": ["table.csv", "notes.md"],
  "graders": [
    {"id": "csv-file", "title": "CSV 存在", "config": {"kind": "file", "path": "table.csv", "minBytes": 20}},
    {"id": "csv-shape", "title": "列和数据行完整", "config": {"kind": "csv", "path": "table.csv", "requiredColumns": ["plan", "price", "limit"], "minRows": 3, "requiredValues": [{"column":"plan","equals":"Pro"}]}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出表格 CSV", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "csv-file"},
    {"id": "shape", "label": "表头和行数正确", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "csv-shape"},
    {"id": "quality", "label": "合并单元格与缺失值处理合理", "source": "judge", "points": 30, "severity": "scored", "rubric": "异常在 notes.md 中记录，CSV 不丢失行或制造假值。"},
    {"id": "human", "label": "人工复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对表格行和缺失项。", "sampleRate": 0.1}
}
