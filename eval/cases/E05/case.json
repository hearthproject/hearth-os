{
  "schemaVersion": 1,
  "id": "E05",
  "version": 1,
  "title": "跨语言邮件摘要与待办",
  "family": "email",
  "difficulty": "edge",
  "runModes": ["offline"],
  "description": "把中英日混合邮件串整理成中文摘要和待办。",
  "goal": "保留原文关键约束，提取负责人、日期和未确认事项。",
  "tags": ["multilingual", "summary"],
  "timeoutMs": 300000,
  "inputs": [{"kind": "file", "label": "多语言邮件串", "path": "input.json"}],
  "expectedOutputs": ["summary.json"],
  "graders": [
    {"id": "file", "title": "摘要存在", "config": {"kind": "file", "path": "summary.json", "minBytes": 40}},
    {"id": "facts", "title": "日期和待办完整", "config": {"kind": "json", "path": "summary.json", "equals": {"deadline":"2026-11-18","owner":"Sato","unknownCount":1}, "minArrayLength": {"actions": 2}}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出摘要", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "负责人、截止日和未知项正确", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "翻译不改变原意", "source": "judge", "points": 30, "severity": "scored", "rubric": "关键约束和语气保持一致，不确定信息进入待确认项。"},
    {"id": "human", "label": "人工复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对翻译、日期和待办。", "sampleRate": 0.1}
}
