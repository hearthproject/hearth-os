{
  "schemaVersion": 1,
  "id": "T10",
  "version": 1,
  "title": "清洗销售 CSV",
  "family": "cross-app",
  "difficulty": "normal",
  "runModes": ["offline"],
  "description": "清洗 20 行销售导出并列出异常。",
  "goal": "保持原始文件不变，生成干净 CSV、异常清单和清洗说明。",
  "tags": ["legacy", "csv", "data"],
  "timeoutMs": 600000,
  "inputs": [{"kind": "file", "label": "销售导出", "path": "eval/inputs/T10-sales-export.csv"}],
  "expectedOutputs": ["cleaned-sales.csv", "exceptions.csv", "change-log.md", "summary.md"],
  "graders": [
    {"id": "cleaned-file", "title": "清洗 CSV 存在", "config": {"kind": "file", "path": "cleaned-sales.csv", "minBytes": 30}},
    {"id": "cleaned-shape", "title": "CSV 结构和异常记录完整", "config": {"kind": "csv", "path": "cleaned-sales.csv", "minRows": 15, "requiredColumns": ["order_id"]}}
  ],
  "criteria": [
    {"id": "cleaned-exist", "label": "输出清洗 CSV", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "cleaned-file"},
    {"id": "cleaned-shape", "label": "清洗结果可解析且行数合理", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "cleaned-shape"},
    {"id": "cleaning-quality", "label": "异常可追溯且原文件不变", "source": "judge", "points": 30, "severity": "scored", "rubric": "异常清单、变更说明和汇总一致，原文件未被修改。"},
    {"id": "cleaning-human", "label": "运营复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "抽查异常记录、清洗结果和汇总。", "sampleRate": 0.1}
}
