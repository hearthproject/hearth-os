{
  "schemaVersion": 1,
  "id": "DESK03",
  "version": 1,
  "title": "表格批量清洗与保存",
  "family": "desktop",
  "difficulty": "edge",
  "runModes": ["offline"],
  "description": "在表格应用中批量规范化日期和空值并另存副本。",
  "goal": "生成单元格动作与目标状态，保留原始工作簿。",
  "tags": ["spreadsheet", "ui-automation"],
  "timeoutMs": 300000,
  "inputs": [{"kind": "file", "label": "工作簿与规则", "path": "input.json"}],
  "expectedOutputs": ["actions.json"],
  "graders": [
    {"id": "file", "title": "表格动作存在", "config": {"kind": "file", "path": "actions.json", "minBytes": 40}},
    {"id": "facts", "title": "清洗动作和另存状态正确", "config": {"kind": "json", "path": "actions.json", "equals": {"cellEdits":3,"saveAs":"cleaned.xlsx","originalOverwritten":false}}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出表格动作", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "编辑和保存边界正确", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "清洗规则一致", "source": "judge", "points": 30, "severity": "scored", "rubric": "日期格式统一，空值按规则处理，原始文件保留。"},
    {"id": "human", "label": "人工复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对单元格修改和原文件保护。", "sampleRate": 0.1}
}
