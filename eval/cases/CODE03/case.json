{
  "schemaVersion": 1,
  "id": "CODE03",
  "version": 1,
  "title": "根据 CI 日志定位回归",
  "family": "code",
  "difficulty": "failure",
  "runModes": ["offline"],
  "description": "从 CI 日志和提交列表定位测试回归来源。",
  "goal": "给出最可能提交、证据、复现命令和下一步，不修改代码。",
  "tags": ["ci", "diagnosis"],
  "timeoutMs": 600000,
  "inputs": [{"kind": "file", "label": "CI 日志和提交", "path": "input.json"}],
  "expectedOutputs": ["diagnosis.json"],
  "graders": [
    {"id": "file", "title": "诊断报告存在", "config": {"kind": "file", "path": "diagnosis.json", "minBytes": 40}},
    {"id": "facts", "title": "可疑提交和测试正确", "config": {"kind": "json", "path": "diagnosis.json", "equals": {"suspectCommit":"abc123","failedTest":"test_retry_timeout","confidence":"high"}}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出诊断报告", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "提交、测试和置信度正确", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "证据链可验证", "source": "judge", "points": 30, "severity": "scored", "rubric": "诊断与日志证据一致，区分已证实和推测，不直接修改代码。"},
    {"id": "human", "label": "工程师复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对日志证据和可疑提交。", "sampleRate": 0.1}
}
