{
  "schemaVersion": 1,
  "id": "E04",
  "version": 1,
  "title": "供应商询价信息提取与回信",
  "family": "email",
  "difficulty": "normal",
  "runModes": ["offline"],
  "description": "从多封供应商回复中提取报价、交期和缺失信息。",
  "goal": "生成三家供应商对比与跟进邮件草稿，不虚构缺失报价。",
  "tags": ["procurement", "quote"],
  "timeoutMs": 300000,
  "inputs": [{"kind": "file", "label": "供应商回复", "path": "input.json"}],
  "expectedOutputs": ["quote.json"],
  "graders": [
    {"id": "file", "title": "询价对比存在", "config": {"kind": "file", "path": "quote.json", "minBytes": 40}},
    {"id": "facts", "title": "三家报价与缺失项完整", "config": {"kind": "json", "path": "quote.json", "requiredPaths": ["vendors.0.price", "vendors.2.missing"], "minArrayLength": {"vendors": 3}, "equals": {"currency": "CNY"}}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出询价对比", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "报价和缺失项完整", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "缺失信息不推测", "source": "judge", "points": 30, "severity": "scored", "rubric": "缺失价格和交期明确标记，跟进草稿只询问已识别缺口。"},
    {"id": "human", "label": "采购复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对三家报价、交期和缺失项。", "sampleRate": 0.1}
}
