{
  "schemaVersion": 1,
  "id": "CODE02",
  "version": 1,
  "title": "小型 PR 风险评审",
  "family": "code",
  "difficulty": "edge",
  "runModes": ["offline"],
  "description": "评审一个含权限检查遗漏的小型 PR。",
  "goal": "输出分级发现、证据和是否阻塞合并。",
  "tags": ["review", "security"],
  "timeoutMs": 600000,
  "inputs": [{"kind": "file", "label": "PR 差异与测试", "path": "input.json"}],
  "expectedOutputs": ["review.json"],
  "graders": [
    {"id": "file", "title": "评审结果存在", "config": {"kind": "file", "path": "review.json", "minBytes": 40}},
    {"id": "facts", "title": "阻塞发现和结论正确", "config": {"kind": "json", "path": "review.json", "equals": {"verdict":"block","blockingCount":1}, "minArrayLength": {"findings": 2}}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出评审结果", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "发现分级和结论正确", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "证据和结论匹配", "source": "judge", "points": 30, "severity": "scored", "rubric": "阻塞发现附文件和行号，说明权限影响，未越权合并。"},
    {"id": "human", "label": "技术负责人复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对权限发现和合并结论。", "sampleRate": 0.1}
}
