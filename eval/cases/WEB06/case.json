{
  "schemaVersion": 1,
  "id": "WEB06",
  "version": 1,
  "title": "页面可访问性审计",
  "family": "web",
  "difficulty": "edge",
  "runModes": ["offline"],
  "description": "检查页面中的键盘、对比度和标签问题。",
  "goal": "按严重程度列问题、元素证据和修复建议。",
  "tags": ["accessibility", "audit"],
  "timeoutMs": 300000,
  "inputs": [{"kind": "file", "label": "页面结构快照", "path": "input.json"}],
  "expectedOutputs": ["audit.json"],
  "graders": [
    {"id": "file", "title": "审计报告存在", "config": {"kind": "file", "path": "audit.json", "minBytes": 60}},
    {"id": "facts", "title": "问题数量与严重度正确", "config": {"kind": "json", "path": "audit.json", "equals": {"issueCount":3,"criticalCount":1}, "minArrayLength": {"issues": 3}}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出审计报告", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "问题和严重度完整", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "证据和修复建议可执行", "source": "judge", "points": 30, "severity": "scored", "rubric": "问题定位到元素，建议符合 WCAG，不把偏好当硬性缺陷。"},
    {"id": "human", "label": "可访问性复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对问题证据和严重度。", "sampleRate": 0.1}
}
