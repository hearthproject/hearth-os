{
  "schemaVersion": 1,
  "id": "RES02",
  "version": 1,
  "title": "论文证据卡与局限分析",
  "family": "research",
  "difficulty": "edge",
  "runModes": ["offline"],
  "description": "从论文摘要和结果表中提取证据卡。",
  "goal": "记录研究问题、样本、主要结果、局限和不能推出的结论。",
  "tags": ["paper", "evidence"],
  "timeoutMs": 600000,
  "inputs": [{"kind": "file", "label": "论文摘录", "path": "input.json"}],
  "expectedOutputs": ["evidence.json"],
  "graders": [
    {"id": "file", "title": "证据卡存在", "config": {"kind": "file", "path": "evidence.json", "minBytes": 60}},
    {"id": "facts", "title": "样本、效应和局限正确", "config": {"kind": "json", "path": "evidence.json", "equals": {"sampleSize":120,"effect":"12%","causalClaimAllowed":false}, "minArrayLength": {"limitations": 2}}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出证据卡", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "样本、效应和因果边界正确", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "证据强度与局限说明充分", "source": "judge", "points": 30, "severity": "scored", "rubric": "区分相关与因果，明确样本和设计限制，不夸大结果。"},
    {"id": "human", "label": "研究复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对样本、效应和局限。", "sampleRate": 0.1}
}
