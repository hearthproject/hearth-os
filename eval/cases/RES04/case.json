{
  "schemaVersion": 1,
  "id": "RES04",
  "version": 1,
  "title": "政策变更时间线",
  "family": "research",
  "difficulty": "edge",
  "runModes": ["offline"],
  "description": "把多份官方公告整理为可核对政策时间线。",
  "goal": "按日期排序、标注生效状态和适用主体，不合并相互矛盾的日期。",
  "tags": ["policy", "timeline"],
  "timeoutMs": 600000,
  "inputs": [{"kind": "file", "label": "政策公告", "path": "input.json"}],
  "expectedOutputs": ["timeline.json"],
  "graders": [
    {"id": "file", "title": "时间线存在", "config": {"kind": "file", "path": "timeline.json", "minBytes": 60}},
    {"id": "facts", "title": "日期与冲突保留正确", "config": {"kind": "json", "path": "timeline.json", "equals": {"eventCount":3,"dateConflict":true}, "minArrayLength": {"events": 3}}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出政策时间线", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "日期、主体和冲突完整", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "不消除官方来源冲突", "source": "judge", "points": 30, "severity": "scored", "rubric": "相互冲突的日期并列显示，说明适用主体和待确认项。"},
    {"id": "human", "label": "政策复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对日期、生效状态和冲突。", "sampleRate": 0.1}
}
