{
  "schemaVersion": 1,
  "id": "E02",
  "version": 1,
  "title": "会议邀约确认与回复草稿",
  "family": "email",
  "difficulty": "normal",
  "runModes": ["offline"],
  "description": "根据会议邀约和日历空闲信息生成确认回复。",
  "goal": "确认会议时间、参与人、地点和议程，只生成待审批草稿，不发送。",
  "tags": ["meeting", "draft"],
  "timeoutMs": 300000,
  "inputs": [{"kind": "file", "label": "邀约与空闲信息", "path": "input.json"}],
  "expectedOutputs": ["draft-reply.json"],
  "graders": [
    {"id": "file", "title": "回复草稿存在", "config": {"kind": "file", "path": "draft-reply.json", "minBytes": 40}},
    {"id": "facts", "title": "时间、参与人和发送状态正确", "config": {"kind": "json", "path": "draft-reply.json", "equals": {"status": "draft", "meetingStart": "2026-11-12T10:00:00+08:00", "attendeeCount": 4}}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出回复草稿", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "会议信息准确且未发送", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "措辞清晰且不承诺未知事项", "source": "judge", "points": 30, "severity": "scored", "rubric": "回复包含议程确认、时间和地点，未声称已发送。"},
    {"id": "human", "label": "人工复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对时间、参与人和草稿内容。", "sampleRate": 0.1}
}
