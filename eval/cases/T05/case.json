{
  "schemaVersion": 1,
  "id": "T05",
  "version": 1,
  "title": "竞品公开定价与功能对比",
  "family": "research",
  "difficulty": "edge",
  "runModes": ["offline", "live-optional"],
  "description": "整理 ClickUp、Linear、Asana 的公开套餐信息。",
  "goal": "生成有来源的竞品定价与功能对比表；未公开内容标记为未公开，不推测价格。",
  "tags": ["legacy", "research", "pricing"],
  "timeoutMs": 900000,
  "inputs": [{"kind": "file", "label": "定价页面离线快照", "path": "pricing-snapshot.md"}],
  "liveInputs": [
    {"kind": "url", "label": "ClickUp Pricing", "value": "https://clickup.com/pricing"},
    {"kind": "url", "label": "Linear Pricing", "value": "https://linear.app/pricing"},
    {"kind": "url", "label": "Asana Pricing", "value": "https://asana.com/pricing"}
  ],
  "networkHosts": ["clickup.com", "linear.app", "asana.com"],
  "expectedOutputs": ["competitor-comparison.md"],
  "graders": [
    {"id": "comparison-file", "title": "对比报告存在", "config": {"kind": "file", "path": "competitor-comparison.md", "minBytes": 100}},
    {"id": "comparison-facts", "title": "三方与来源齐全", "config": {"kind": "text", "path": "competitor-comparison.md", "includes": ["ClickUp", "Linear", "Asana", "未公开", "来源"]}}
  ],
  "criteria": [
    {"id": "comparison-exist", "label": "输出竞品对比", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "comparison-file"},
    {"id": "comparison-facts", "label": "三方信息与未知项齐全", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "comparison-facts"},
    {"id": "comparison-quality", "label": "价格和功能可追溯", "source": "judge", "points": 30, "severity": "scored", "rubric": "每个价格和功能结论附官方来源与日期，未公开项不被推测，附人工确认问题。"},
    {"id": "comparison-human", "label": "人工验收", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对价格、来源和未公开项。", "sampleRate": 0.1}
}
