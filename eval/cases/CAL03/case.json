{
  "schemaVersion": 1,
  "id": "CAL03",
  "version": 1,
  "title": "日程冲突检测与替代时段",
  "family": "calendar",
  "difficulty": "edge",
  "runModes": ["offline"],
  "description": "识别重叠会议并给出两个无冲突替代时段。",
  "goal": "列出冲突事件、影响和两个可用替代时段。",
  "tags": ["conflict", "alternatives"],
  "timeoutMs": 300000,
  "inputs": [{"kind": "file", "label": "日程数据", "path": "input.json"}],
  "expectedOutputs": ["conflicts.json"],
  "graders": [
    {"id": "file", "title": "冲突分析存在", "config": {"kind": "file", "path": "conflicts.json", "minBytes": 40}},
    {"id": "facts", "title": "冲突与替代时段正确", "config": {"kind": "json", "path": "conflicts.json", "equals": {"conflictCount":1,"hasConflict":true}, "minArrayLength": {"alternatives": 2}}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出冲突分析", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "冲突和替代时段正确", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "建议尊重优先级", "source": "judge", "points": 30, "severity": "scored", "rubric": "区分硬冲突与缓冲冲突，替代时段不与固定会议重叠。"},
    {"id": "human", "label": "人工复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对冲突与替代时段。", "sampleRate": 0.1}
}
