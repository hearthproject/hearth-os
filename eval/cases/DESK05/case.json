{
  "schemaVersion": 1,
  "id": "DESK05",
  "version": 1,
  "title": "桌面会话中断恢复",
  "family": "desktop",
  "difficulty": "failure",
  "runModes": ["offline"],
  "description": "桌面会话在保存前中断后恢复并避免重复提交。",
  "goal": "从检查点恢复表单、确认已保存状态并避免重复动作。",
  "tags": ["checkpoint", "recovery"],
  "timeoutMs": 300000,
  "inputs": [{"kind": "file", "label": "会话与检查点", "path": "input.json"}],
  "expectedOutputs": ["recovery.json"],
  "graders": [
    {"id": "file", "title": "恢复报告存在", "config": {"kind": "file", "path": "recovery.json", "minBytes": 40}},
    {"id": "facts", "title": "恢复和去重结果正确", "config": {"kind": "json", "path": "recovery.json", "equals": {"resumedFromCheckpoint":true,"duplicateSubmitBlocked":true,"finalState":"saved"}}}
  ],
  "criteria": [
    {"id": "exists", "label": "输出恢复报告", "source": "deterministic", "points": 30, "severity": "blocker", "graderId": "file"},
    {"id": "facts", "label": "检查点和去重结果正确", "source": "deterministic", "points": 30, "severity": "scored", "graderId": "facts"},
    {"id": "quality", "label": "恢复过程不重复副作用", "source": "judge", "points": 30, "severity": "scored", "rubric": "说明中断点和恢复依据，没有重复保存或提交。"},
    {"id": "human", "label": "人工复核", "source": "human", "points": 10, "severity": "scored"}
  ],
  "humanReview": {"prompt": "核对检查点、恢复和去重。", "sampleRate": 0.2}
}
