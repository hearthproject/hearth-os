{
  "name": "hearth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hearth local-first personal agent OS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm run dev -w @hearth/server\" \"npm run dev -w @hearth/web\"",
    "build": "npm run build -w @hearth/web",
    "start": "npm run start -w @hearth/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "desktop:build:shell": "tsc -p apps/desktop/tsconfig.json",
    "desktop:build:dir": "node scripts/build-desktop.mjs --dir",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:start": "npm run desktop:build:shell && electron apps/desktop/dist/main.js",
    "desktop:dev": "npm run desktop:build:shell && npm run build -w @hearth/web && electron apps/desktop/dist/main.js",
    "desktop:typecheck": "tsc -p apps/desktop/tsconfig.json --noEmit",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "helper:windows": "node tools/windows-helper/helper.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "screenshots:readme": "node scripts/readme-screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "mermaid": "^11.4.1",
    "playwright": "^1.64.1",
    "png-to-ico": "^2.1.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^3.2.4",
    "vue": "^3.5.44"
  }
}
