{
  "name": "hearth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hearth local-first personal agent OS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm run dev -w @hearth/server\" \"npm run dev -w @hearth/web\"",
    "dev:eval": "concurrently -k -n eval-server,eval-web -c magenta,cyan \"npm run dev -w @hearth/eval-server\" \"npm run dev -w @hearth/eval-web\"",
    "dev:eval-server": "npm run dev -w @hearth/eval-server",
    "dev:eval-web": "npm run dev -w @hearth/eval-web",
    "build": "npm run build -w @hearth/web",
    "build:eval-web": "npm run build -w @hearth/eval-web",
    "start": "npm run start -w @hearth/server",
    "start:eval": "npm run start -w @hearth/eval-server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "helper:windows": "node tools/windows-helper/helper.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "screenshots:readme": "node scripts/readme-screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "mermaid": "^11.4.1",
    "playwright": "^1.64.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.44"
  }
}
