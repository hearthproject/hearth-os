{
  "name": "hearth",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "Hearth local-first personal agent OS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm run dev -w @hearth/server\" \"npm run dev -w @hearth/web\"",
    "build": "npm run build -w @hearth/web",
    "start": "npm run start -w @hearth/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "tsx scripts/browser-e2e.ts",
    "test:e2e": "npm run test:browser && node scripts/e2e.mjs",
    "test:longrun": "vitest run --config vitest.longrun.config.ts",
    "bench:aci": "tsx scripts/bench/aci-bench.ts post-change.json",
    "bench:legacy": "tsx scripts/bench/legacy-aci.ts pre-change.json",
    "bench:suite": "tsx scripts/bench/run-suite.ts",
    "agent:run": "tsx scripts/bench/run-agent.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "version:sync": "node scripts/sync-version.mjs --write",
    "version:check": "node scripts/sync-version.mjs --check",
    "tauri:build": "node scripts/build-tauri.mjs",
    "helper:windows": "node tools/windows-helper/helper.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "screenshots:readme": "node scripts/readme-screenshots.mjs",
    "dogfood:report": "tsx scripts/dogfood-report.ts",
    "release:build": "node scripts/build-tauri.mjs",
    "release:prepare": "node scripts/release.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "husky": "^9.1.7",
    "mermaid": "^11.4.1",
    "playwright": "^1.64.1",
    "png-to-ico": "^2.1.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^3.2.4",
    "vue": "^3.5.44"
  }
}
