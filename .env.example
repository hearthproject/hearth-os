# Hearth local server configuration.
# Copy to `.env` only if you need to override a default. The server reads only
# the process environment (start it through npm or your desktop launcher).

# Repository or install root. All data paths are anchored here.
# HEARTH_ROOT=D:\App\hearth-os

# Local API. Keep it on loopback unless you know why you need otherwise.
# HEARTH_HOST=127.0.0.1
# HEARTH_PORT=4317

# Browser automation. Hearth uses a separate Chrome profile so it never reads
# your daily cookies. Set HEARTH_BROWSER=0 to disable it entirely.
# HEARTH_BROWSER=1
# Optional explicit Chrome/Edge/Chromium executable:
# HEARTH_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional bridge reserve for a future signed browser extension.
# HEARTH_BROWSER_BRIDGE=1
# HEARTH_BROWSER_BRIDGE_PORT=4318

# Optional executor overrides.
# HEARTH_CODEX_PATH=codex
# HEARTH_NATIVE_SANDBOX=1

# Optional web build location when serving a packaged desktop build.
# HEARTH_WEB_DIST=D:\App\hearth-os\apps\web\dist
