{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:4317",
      "http://localhost:4317"
    ]
  },
  "permissions": [
    "core:default",
    "allow-pick-folder",
    "allow-open-external-url"
  ]
}
